# OpenClaw 环境变量配置文件
# 复制此文件为 .env 并填写实际值

# ============================================
# 数据目录配置
# ============================================
OPENCLAW_DATA_DIR=/data/openclaw

# ============================================
# LLM Provider 配置 (通用)
# ============================================
# Provider ID: dashscope, openai, anthropic, google, etc.
LLM_PROVIDER=dashscope
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL_ID=qwen3-max-2026-01-23
LLM_API_TYPE=openai-completions

# 其他 Provider 示例:
# OpenAI:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-your-openai-key
#   LLM_MODEL_ID=gpt-4
#   LLM_API_TYPE=openai-completions
#
# Anthropic:
#   LLM_PROVIDER=anthropic
#   LLM_BASE_URL=https://api.anthropic.com
#   LLM_API_KEY=sk-ant-your-key
#   LLM_MODEL_ID=claude-sonnet-4-5
#   LLM_API_TYPE=anthropic

# ============================================
# 企业微信配置
# ============================================
# AI 机器人回调配置（必填）
WECOM_TOKEN=your-wxwork-token-here
WECOM_ENCODING_AES_KEY=your-wxwork-encoding-aes-key-here
WECOM_WEBHOOK_PATH=/wecom

# 企业微信 API 配置（可选，用于通讯录、主动推送等高级功能）
# 如需使用以下功能，必须配置 corpId 和 secret：
#   - 获取用户详细信息（姓名、部门等）
#   - 主动推送消息给用户
#   - 上传/下载媒体文件
#   - 语音消息下载
# 
# 获取方式：
#   corpId: 企业微信管理后台 -> 我的企业 -> 企业ID
#   secret: 企业微信管理后台 -> 应用管理 -> 自建应用 -> Secret
#   agentId: 企业微信管理后台 -> 应用管理 -> 自建应用 -> AgentId
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=

# ============================================
# Gateway 配置
# ============================================
GATEWAY_PORT=18789
GATEWAY_MODE=local
GATEWAY_BIND=lan
GATEWAY_AUTH_TOKEN=your-gateway-auth-token-here

# ============================================
# Docker 配置
# ============================================
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:main
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000
DOCKER_GID=989

# ============================================
# 时区配置
# ============================================
USER_TIMEZONE=Asia/Shanghai
TIME_FORMAT=24
